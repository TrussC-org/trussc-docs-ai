node_modules/
# the corpus is generated at deploy time by update-corpus.sh (see README), never committed
chunks.jsonl
chunks.embedded.json
chunks.embedded.next.json
chunks.embedded.prev.json
# GitHub caches refreshed by fetch-*.mjs on every rebuild (build-chunks skips them if missing)
releases.json
issues.json
addon-registry.json
# dev/session artifacts
eval-report.txt
MORNING.md
*.log
# usage logs (privacy: contains questions + hashed IPs — never commit)
stats.jsonl

# machine-local deploy overrides: the committed deploy/ files are TEMPLATES.
# The real unit/tunnel config for a given box carries its paths, its node
# binary and — critically — a real STATS_SALT, so it must never be committed.
deploy/*.local
deploy/*.local.*
